# Copy to .env.local and fill in from your Supabase project:
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used for absolute URLs in metadata and the PWA manifest.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: never put the service_role key in this file or anywhere in the app.
# Every write goes through an authenticated user and Row Level Security.

# --- AI (Groq) -------------------------------------------------------------
# Server-only. Never prefixed with NEXT_PUBLIC_, so it can never reach the browser.
# Get one at https://console.groq.com/keys
#
# One key, or several comma-separated for failover:
#   GROQ_API_KEYS=gsk_aaa,gsk_bbb
# Extra keys give failover if one is revoked or hiccups. They do NOT raise the
# rate limit when they come from the same Groq account — Groq meters per
# organization. Verify with: node scripts/check-groq-keys.mjs
GROQ_API_KEYS=
# Optional: override the tool-use model.
GROQ_MODEL=openai/gpt-oss-120b

# Per-visitor AI messages allowed per minute (default 12).
AI_RATE_LIMIT_PER_MIN=12
